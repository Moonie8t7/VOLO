{
  "name": "volo-bg3-load-order-optimiser",
  "version": "1.0.0",
  "description": "VOLO. Verified Order & Load Optimisation for BG3 Mods. A community-curated load order optimiser that runs entirely in your browser.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "VOLO Contributors"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run masterlist && node scripts/build-sitemap.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "tsc",
    "test": "node scripts/smoke-test.mjs",
    "verify-deploy": "node scripts/verify-deploy.mjs",
    "masterlist": "node scripts/mine-corpus.mjs && node scripts/build-divider-map.mjs && node -e \"require('fs').copyFileSync('masterlist/bg3-masterlist.json','public/bg3-masterlist.json')\""
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.5",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.2.0"
  }
}
