# Vite fingerprints everything under /assets, so those files never change at a
# given URL and can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The masterlist keeps a stable URL and changes when submissions merge. An hour
# of caching keeps it fast without holding users on stale data for long.
/bg3-masterlist.json
  Cache-Control: public, max-age=3600

/index.html
  Cache-Control: public, max-age=0, must-revalidate
